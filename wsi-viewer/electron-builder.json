{
  "appId": "com.imagebox3.wsihive",
  "productName": "WSI Hive",
  "files": [
    "out/**/*",
    "package.json"
  ],
  "directories": {
    "buildResources": "build",
    "output": "dist"
  },
  "asar": true,
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "nsis"
    ]
  },
  "portable": {
    "artifactName": "WSI-Hive-${os}-${arch}-portable.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "icon": "build/icon.icns",
    "target": [
      "dmg",
      "zip",
      "dir"
    ],
    "category": "public.app-category.medical"
  },
  "linux": {
    "target": [
      "AppImage"
    ]
  }
}
